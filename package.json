{
  "name": "wheredabus",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-location": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:scripts": "node --test \"scripts/build-gtfs/**/*.test.mjs\" \"data/gtfs/__tests__/*.test.mjs\"",
    "build:gtfs": "node scripts/build-gtfs/build.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/scripts/",
      "/\\.claude/"
    ],
    "modulePathIgnorePatterns": [
      "/\\.claude/"
    ]
  },
  "private": true
}
