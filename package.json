  "main": "expo-router/entry",
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-linking": "~8.0.12",
    "expo-location": "19.0",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "16.0",
    "expo-status-bar": "3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "19.1",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.17",
    "typescript": "5.9"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:scripts": "node --test \"scripts/build-gtfs/**/*.test.mjs\" \"data/gtfs/__tests__/*.test.mjs\"",
    "build:gtfs": "node scripts/build-gtfs/build.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/scripts/",
      "/\\.claude/"
    ],
    "modulePathIgnorePatterns": [
      "/\\.claude/"
    ],
    "testTimeout": 20000
  },
  "private": true
}
