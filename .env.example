# Copy to .env and fill in. .env is gitignored.
#
# AppID from https://hea.thebus.org/api_info.asp
#
# EXPO_PUBLIC_ exposes this to client code, which means it is embedded in the
# app bundle and extractable from the .ipa. That is an accepted consequence of
# parsing the API in-app rather than behind a proxy — gitignoring it keeps it
# out of version history, not out of the shipped binary.
EXPO_PUBLIC_THEBUS_APP_ID=
